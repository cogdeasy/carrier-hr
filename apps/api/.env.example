# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=8h

# Database
# Local development uses an embedded SQLite file.
# For production (Turso), set DATABASE_URL=libsql://<db>.turso.io and DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Seed/default password used by db:seed AND assigned as the temporary password
# for accounts provisioned via the employee-creation API (users are forced to
# change it on first login). This is a LOCAL DEMO default only — you MUST set a
# strong, unique value in any shared/staging/production environment.
SEED_DEFAULT_PASSWORD=Password123!

# Web demo panel: set VITE_DEMO_MODE=true when building apps/web to render the
# one-click demo-account login panel. Leave unset/false for production builds so
# seed credentials are never shown in the UI.
