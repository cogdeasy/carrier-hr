# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=8h

# Database
# Local development uses an embedded SQLite file.
# For production (Turso), set DATABASE_URL=libsql://<db>.turso.io and DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Seed admin (used by db:seed)
SEED_DEFAULT_PASSWORD=Password123!
