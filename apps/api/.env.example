# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS — comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Auth
# Leave JWT_SECRET unset for local dev: the server generates a fresh ephemeral
# secret per process (sessions reset on restart). For any shared/staging/
# production environment you MUST set a strong, unique value, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Database
# Local development uses an embedded SQLite file.
# For production (Turso), set DATABASE_URL=libsql://<db>.turso.io and DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Password assigned to the demo accounts created by `pnpm db:seed` only. This is
# a LOCAL DEMO default — production does not run the seed script, and accounts
# provisioned via the employee-creation API instead get a unique, random
# temporary password (returned once to the admin). Override for any shared seed.
SEED_DEFAULT_PASSWORD=Password123!

# Web demo panel: set VITE_DEMO_MODE=true when building apps/web to render the
# one-click demo-account login panel. Leave unset/false for production builds so
# seed credentials are never shown in the UI.
